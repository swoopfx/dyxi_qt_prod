# ==============================================================================
# Enterprise Security Environment Configuration Override File (.env.security)
# ==============================================================================

# Target REST Backend API Endpoint
ENTERPRISE_AUTH_ENDPOINT=https://api.enterprise-security.internal/v1/auth/login

# Network Timeout Threshold (in milliseconds)
ENTERPRISE_AUTH_TIMEOUT_MS=1200

# Target Deployment Stage (development | staging | production)
ENTERPRISE_TARGET_ENV=development

# Multi-Provider OAuth 2.0 Client Credentials (Public Client ID - No Secret Needed)
GOOGLE_CLIENT_ID=952310262713-4b1f3os6uqmhorsjmp9tmritbph1m6sg.apps.googleusercontent.com
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

APPLE_CLIENT_ID=com.enterprise.herogate.client
APPLE_TEAM_ID=TEAM998877
APPLE_KEY_ID=KEY112233
APPLE_PRIVATE_KEY_PATH=/etc/security/keys/apple_private_key.p8
